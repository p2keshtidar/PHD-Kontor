# Vorlage für den Betrieb (docker-compose.prod.yml). Kopieren nach .env und ALLE Werte ersetzen.
# .env steht in .gitignore und darf NIE ins Repository. Werte erzeugen, z. B.:
#   openssl rand -base64 48   (JWT_SECRET)      openssl rand -base64 32   (CARD_KEY, genau 32 Byte)
#   openssl rand -base64 24   (DB_PASSWORD, ADMIN_PASSWORD)

APP_ENV=production
DB_PASSWORD=bitte-ersetzen
JWT_SECRET=bitte-ersetzen
# Verschlüsselt Kartendaten, Bankfreigaben und Dokumente. Geht er verloren, sind diese Daten nicht mehr lesbar.
CARD_KEY=bitte-ersetzen
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=bitte-ersetzen

# Öffentliche Adresse des Servers (für den Rücksprung nach einer Bankfreigabe)
BANKING_REDIRECT_URL=https://girokonto.example.org/api/banking/callback
# Sandbox-Banken mit Testdaten anbieten (true) oder nicht (false)
BANKING_SANDBOX=true
# Echte Bankverbindungen nur mit Vertrag und eigenen Zugangsdaten – sonst leer lassen
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# optional
SLOW_REQUEST_MS=1000
LOAN_MARKET_RATES=true
